APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

PHYSICS_MCP_MODE=mock
PHYSICS_MCP_VL_COMMAND=
PHYSICS_MCP_LLM_COMMAND=

PHYSICS_DB_PATH=./data/app-db/physics_vault.sqlite3
PHYSICS_REVIEW_DB_PATH=./data/mcp/review_workspace.sqlite3

# Semantic question retrieval. Keep the API key in a local .env or the app's
# runtime AI settings; never commit the real key.
DASHSCOPE_API_KEY=
PHYSICS_VAULT_ALIBABA_WORKSPACE_ID=
PHYSICS_VAULT_EMBEDDING_PROVIDER=alibaba
PHYSICS_VAULT_EMBEDDING_MODEL=text-embedding-v3
PHYSICS_VAULT_EMBEDDING_VECTOR_TYPE=semantic_search
PHYSICS_VAULT_ALIBABA_BASE_URL=
PHYSICS_VAULT_RERANK_MODEL=gte-rerank-v2
PHYSICS_VAULT_RERANK_BASE_URL=
PHYSICS_VAULT_RETRIEVAL_CANDIDATE_LIMIT=80
PHYSICS_VAULT_EMBEDDING_CONCURRENCY=1
PHYSICS_VAULT_EMBEDDING_MAX_RETRIES=8
PHYSICS_VAULT_EMBEDDING_DIMENSIONS=1024
PHYSICS_VAULT_EMBEDDING_AUTO_REFRESH=true

# Long-running imports and AI cleanup. Leave disabled for single-process dev.
PHYSICS_TASK_QUEUE_ENABLED=false
PHYSICS_TASK_BROKER_URL=redis://127.0.0.1:6379/0
PHYSICS_TASK_QUEUE_NAMESPACE=physics-vault
PHYSICS_TASK_QUEUE_NAME=imports
PHYSICS_TASK_CONTROL_QUEUE_NAME=import-control
PHYSICS_TASK_MAX_RETRIES=4
PHYSICS_TASK_MIN_BACKOFF_MS=5000
PHYSICS_TASK_MAX_BACKOFF_MS=300000
PHYSICS_TASK_TIME_LIMIT_MS=1800000
PHYSICS_TASK_REDIS_TIMEOUT_SECONDS=2
PHYSICS_TASK_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
PHYSICS_TASK_WORKER_HEARTBEAT_TTL_SECONDS=35
PHYSICS_TASK_STALE_AFTER_SECONDS=1900

# Bump when import/cleaning semantics change to invalidate cached task results.
PHYSICS_IMPORT_CONFIG_VERSION=1

# Server-side DOCX/PPTX exports.
PHYSICS_EXPORT_DIR=./data/exports
PHYSICS_EXPORT_RETENTION_DAYS=30
PHYSICS_EXPORT_MAX_SNAPSHOT_BYTES=26214400
