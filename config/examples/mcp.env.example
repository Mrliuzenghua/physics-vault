PHYSICS_AI_ENABLED=true
PHYSICS_MCP_MODE=mock
PHYSICS_MCP_WORKDIR=.
PHYSICS_MCP_VL_COMMAND=python scripts/dev/mock_vl_mcp.py
PHYSICS_MCP_LLM_COMMAND=python scripts/dev/mock_llm_mcp.py

# ── Timeouts (ms) ──
PHYSICS_MCP_PARSE_TIMEOUT_MS=60000
PHYSICS_MCP_ANALYSIS_TIMEOUT_MS=20000
PHYSICS_MCP_KNOWLEDGE_TIMEOUT_MS=25000
PHYSICS_MCP_METADATA_TIMEOUT_MS=40000

# ── Logging ──
PHYSICS_MCP_LOG_ENABLED=true
PHYSICS_MCP_LOG_DIR=./data/logs/mcp
PHYSICS_MCP_LOG_REQUESTS=true
PHYSICS_MCP_LOG_RESPONSES=true
PHYSICS_MCP_LOG_MAX_PAYLOAD_CHARS=2000

# ── Retry ──
PHYSICS_MCP_MAX_RETRIES=2
PHYSICS_MCP_RETRY_DELAY_MS=500

# 仅用于无正式数据库的演示环境。生产环境不要开启。
PHYSICS_ALLOW_DEMO_DATA=false
